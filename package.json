{
  "name": "sentinel-av",
  "version": "1.3.0",
  "description": "A considered Windows desktop companion for ClamAV",
  "author": "WellSpring Studio",
  "license": "MIT",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:integration": "node scripts/integration.cjs",
    "test:monitor": "node scripts/test-monitor-integration.cjs",
    "build:service": "powershell -NoProfile -File scripts/build-service.ps1",
    "prepare:tools": "node scripts/prepare-tools.cjs",
    "pack": "npm run prepare:tools && npm run build:service && electron-builder --win --dir",
    "dist": "node scripts/check-signing.cjs && npm run prepare:tools && npm run build:service && electron-builder --win nsis --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:smoke": "node scripts/smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "prettier": "3.9.9"
  },
  "build": {
    "extraResources": [
      {
        "from": "vendor",
        "to": "engines",
        "filter": [
          "**/*",
          "!**/*.zip",
          "!**/*.pdb",
          "!**/*.lib",
          "!**/osqueryd/**"
        ]
      },
      {
        "from": "config/clamd.conf",
        "to": "engines/clamav/clamd.conf.template"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "engines/THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "src",
        "to": "monitor/src",
        "filter": [
          "**/*.cjs",
          "!smoke.cjs"
        ]
      },
      {
        "from": "service/SentinelMonitor.exe",
        "to": "monitor/SentinelMonitor.exe"
      },
      {
        "from": "scripts/install-service.ps1",
        "to": "monitor/install-service.ps1"
      },
      {
        "from": "scripts/uninstall-service.ps1",
        "to": "monitor/uninstall-service.ps1"
      }
    ],
    "appId": "com.wellspring.sentinel",
    "productName": "Sentinel AV",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "!src/smoke.cjs",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Sentinel-AV-Setup-${version}.exe"
    }
  }
}
